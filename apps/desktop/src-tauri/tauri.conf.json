{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SortSmith",
  "version": "0.2.0",
  "identifier": "in.sanskar.sortsmith",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SortSmith",
        "width": 1180,
        "height": 760,
        "minWidth": 820,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Private, reversible file organization.",
    "longDescription": "SortSmith organizes files using local rules, dry-run previews, duplicate detection, and reversible journals.",
    "copyright": "Copyright © 2026 Sanskar",
    "resources": [],
    "icon": [
      "icons/icon.png"
    ]
  }
}
